{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Assistant",
  "version": "1.0.0",
  "identifier": "com.ai.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Assistant",
        "width": 420,
        "height": 520,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "contentProtected": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 AI Assistant",
    "category": "Productivity",
    "shortDescription": "AI-powered interview practice assistant",
    "longDescription": "Real-time AI interview assistant for Zoom, Meet, Teams, HackerRank, and more.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
